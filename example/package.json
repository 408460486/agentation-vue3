{
  "name": "agentation-vue3-example",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate && node -e \"require('fs').writeFileSync('dist/_redirects', '')\"",
    "preview": "nuxt preview",
    "deploy:cf": "nuxt generate && node -e \"require('fs').writeFileSync('dist/_redirects', '# Static site\\n')\" && wrangler pages deploy dist"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "nuxt": "3.15.0",
    "sass": "1.97.0",
    "wrangler": "^3.0.0"
  },
  "dependencies": {
    "agentation-vue3": "latest"
  }
}
